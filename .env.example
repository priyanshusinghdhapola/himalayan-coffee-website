# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Canonical production URL — used for metadata, Open Graph, sitemap and JSON-LD.
# Set it to your real domain once you have one, e.g. https://www.<your-domain>
# (a bare host is accepted and gets https:// added). Leave empty to use the
# Vercel production domain automatically; local builds use http://localhost:3000.
# An invalid value is ignored with a build warning — it never fails the build.
NEXT_PUBLIC_SITE_URL=

# Optional. Serve /media from a CDN (Vercel Blob, Cloudflare R2, Bunny…) instead
# of /public. Upload the *contents* of public/ so files live at
# <base>/media/hero/desktop/frame_0001.webp etc. Leave empty to use /public.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Bump this whenever you replace media files with new versions under the same
# names. /media is cached as immutable for a year, so the version query string
# is what forces browsers to fetch the new files.
NEXT_PUBLIC_MEDIA_VERSION=1

# Optional. Where waitlist / notify-me / newsletter sign-ups are POSTed as JSON
# (Zapier, Make, n8n, Google Apps Script, Slack incoming webhook…). If empty,
# sign-ups are only written to the server log.
WAITLIST_WEBHOOK_URL=

# Optional. Your real storefront URL. Used as the Buy link only for products
# marked placeholder: false whose offers have no checkoutUrl of their own.
# Products without a buy link show "Notify me" (email sign-up) instead.
NEXT_PUBLIC_SHOP_URL=
